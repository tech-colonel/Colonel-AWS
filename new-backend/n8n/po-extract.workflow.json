      "id": "b1a10000-0000-4000-8000-000000000003",
      "name": "List PO PDFs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-740, 300],
      "credentials": { "googleDriveOAuth2Api": { "id": "", "name": "Google Drive account (n8n)" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.backendBaseUrl }}/api/n8n/progress",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"brandId\": $('Config').item.json.brandId, \"agentId\": $('Config').item.json.agentId, \"brandName\": $('Config').item.json.brandName, \"agentName\": $('Config').item.json.agentName, \"phase\": \"start\", \"total\": ($json.files || []).length } }}",
        "options": {}
      },
      "id": "b1a10000-0000-4000-8000-000000000004",
      "name": "Progress: start",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-520, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const files = ($('List PO PDFs').first().json.files) || [];\nreturn files.map(f => ({ json: {\n  id: f.id,\n  name: f.name,\n  webViewLink: f.webViewLink,\n  batch_total: files.length\n} }));\n"
      },
      "id": "b1a10000-0000-4000-8000-000000000005",
      "name": "Split Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-300, 300]
    },
    {
      "parameters": { "options": { "reset": false } },
      "id": "b1a10000-0000-4000-8000-000000000006",
      "name": "Loop Over POs",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-80, 300]
    },
    {
      "parameters": {
        "url": "={{ 'https://www.googleapis.com/drive/v3/files/' + $json.id + '?alt=media&supportsAllDrives=true' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": { "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } } }
      },
      "id": "b1a10000-0000-4000-8000-000000000007",
      "name": "Download PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 420],
      "credentials": { "googleDriveOAuth2Api": { "id": "", "name": "Google Drive account (n8n)" } }
    },
    {
      "parameters": {
        "jsCode": "const b64 = $input.item.binary.data.data;\nconst prompt = [\n  'You are a data-extraction engine. The attached PDF is (or may be) a PURCHASE ORDER (PO) raised by a customer on a supplier.',\n  'Return ONE JSON object only. No markdown, no commentary. Use exactly this schema:',\n  '{',\n  '  \"is_purchase_order\": true,',\n  '  \"po_number\": \"\",',\n  '  \"po_date\": \"\",',\n  '  \"supplier_gstin\": \"\",',\n  '  \"buyer_gstin\": \"\",',\n  '  \"billing_address\": \"\",',\n  '  \"line_items\": [ { \"description\": \"\", \"unit_cost\": 0, \"gst_rate\": 0 } ]',\n  '}',\n  'Field guide:',\n  '- po_number: the Purchase Order No. / PO No.',\n  '- po_date: the PO Date, formatted DD-MM-YYYY.',\n  '- supplier_gstin: the GSTIN in the SUPPLIER / \"Vendor Details\" block (the party fulfilling the order).',\n  '- buyer_gstin: the GSTIN in the \"Billing Address\" / \"Bill To\" / Buyer block (the party that raised the PO).',\n  '- billing_address: the full billing / \"Deliver to\" address as ONE line (collapse newlines to spaces, strip HTML like <br>).',\n  '- line_items: ONE entry per ordered product row. description = the item description. unit_cost = the per-unit \"Unit Cost\" / \"Basic Cost\" (NOT MRP, NOT taxable value, NOT line total). gst_rate = the GST percentage as a number (e.g. 18).',\n  'Numbers as plain numbers (no currency symbols, no thousands separators). Missing text -> \"\". Missing number -> 0.',\n  'If the document is clearly NOT a purchase order (a sales invoice, bank statement, unrelated doc), set is_purchase_order to false and still return the object. Never invent values.'\n].join('\\n');\nreturn { json: { geminiBody: {\n  contents: [ { role: 'user', parts: [\n    { inline_data: { mime_type: 'application/pdf', data: b64 } },\n    { text: prompt }\n  ] } ],\n  generationConfig: { temperature: 0, response_mime_type: 'application/json' }\n} } };\n"
      },
      "id": "b1a10000-0000-4000-8000-000000000008",
      "name": "Build Gemini Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://generativelanguage.googleapis.com/v1beta/models/' + $('Config').item.json.geminiModel + ':generateContent' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-goog-api-key", "value": "={{ $('Config').item.json.geminiApiKey }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.geminiBody }}",
        "options": { "timeout": 120000 }
      },
      "id": "b1a10000-0000-4000-8000-000000000009",
      "name": "Gemini: extract PO",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 420]
    },
    {
      "parameters": {
        "jsCode": "const cfg  = $('Config').first().json;\nconst file = $('Loop Over POs').item.json;\nconst resp = $input.item.json;\n\nlet text = '';\ntry { text = resp.candidates[0].content.parts[0].text; } catch (e) { text = ''; }\nlet po = {};\ntry { po = JSON.parse(text); } catch (e) { po = {}; }\n\nconst items = (Array.isArray(po.line_items) && po.line_items.length) ? po.line_items : [{}];\nconst runId = $execution.id;\nconst num = (v) => { const n = parseFloat(String(v ?? '').replace(/[,\\s\\u20b9]/g, '')); return isNaN(n) ? 0 : n; };\nconst s   = (v) => (v === undefined || v === null) ? '' : String(v).replace(/<br\\s*\\/?>(?:\\s*)/gi, ' ').replace(/\\s+/g, ' ').trim();\nconst isPO = po.is_purchase_order !== false && (s(po.po_number) || items.some((it) => s(it.description)));\n\nconst rows = items.map((it) => ({\n  run_id: runId,\n  batch_total: file.batch_total || 0,\n  brandId: cfg.brandId, brandName: cfg.brandName,\n  agentId: cfg.agentId, agentName: cfg.agentName,\n  source_file: s(file.name),\n  po_pdf_link: s(file.webViewLink),\n  po_number: s(po.po_number),\n  po_date: s(po.po_date),\n  supplier_gstin: s(po.supplier_gstin),\n  buyer_gstin: s(po.buyer_gstin),\n  billing_address: s(po.billing_address),\n  product_description: s(it.description),\n  unit_cost: num(it.unit_cost),\n  gst_rate: num(it.gst_rate),\n  status: !isPO ? 'Not a PO' : ((s(po.po_number) && s(it.description)) ? 'Extracted' : 'Needs Review')\n}));\n\n// Google Sheet — exactly the 8 columns of \"PO Data for Automation.xlsx\", one row per line item.\nconst sheetValues = rows.map((r) => [\n  r.po_number, r.po_date, r.supplier_gstin, r.buyer_gstin,\n  r.billing_address, r.product_description, r.unit_cost, r.gst_rate\n]);\n\nreturn { json: { rows, sheetValues, po_number: rows[0].po_number, status: rows[0].status } };\n"
      },
      "id": "b1a10000-0000-4000-8000-00000000000a",
      "name": "Build Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 420]
    },
