      "typeVersion": 4.2,
      "position": [1320, 420],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://www.googleapis.com/drive/v3/files/' + $('Loop Over POs').item.json.id + '?addParents=' + $('Config').item.json.processedFolderId + '&removeParents=' + $('Config').item.json.driveFolderId + '&supportsAllDrives=true' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {}
      },
      "id": "b1a10000-0000-4000-8000-00000000000d",
      "name": "Move to Processed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 420],
      "onError": "continueRegularOutput",
      "credentials": { "googleDriveOAuth2Api": { "id": "", "name": "Google Drive account (n8n)" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.backendBaseUrl }}/api/n8n/progress",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"brandId\": $('Config').item.json.brandId, \"agentId\": $('Config').item.json.agentId, \"brandName\": $('Config').item.json.brandName, \"agentName\": $('Config').item.json.agentName, \"phase\": \"done\" } }}",
        "options": {}
      },
      "id": "b1a10000-0000-4000-8000-00000000000e",
      "name": "Progress: done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 180],
      "onError": "continueRegularOutput"
    }
  ],
