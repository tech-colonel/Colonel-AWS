            "Billing address / Deliverd to": "={{ $json.billing_address }}",
            "Product description/Item Description": "={{ $json.product_description }}",
            "Material Code / SKU Code": "={{ $json.material_code ? \"'\" + $json.material_code : '' }}",
            "FG": "==IFERROR(XLOOKUP(UPPER(TRIM(TO_TEXT(INDEX($H:$H,ROW())))),ARRAYFORMULA(UPPER(TRIM(TO_TEXT(SKU_Master!$A$2:$A)))),SKU_Master!$B$2:$B,\"\"),\"\")",
            "Basic Cost price/Unit Cost": "={{ $json.unit_cost }}",
            "GST rate": "={{ $json.gst_rate }}",
            "QTY": "={{ $json.qty == null ? '' : $json.qty }}",
            "Taxable": "==IF(OR(INDEX($J:$J,ROW())=\"\",INDEX($L:$L,ROW())=\"\"),\"\",ROUND(INDEX($J:$J,ROW())*INDEX($L:$L,ROW()),2))",
            "IGST": "==IF(OR(LEN(INDEX($C:$C,ROW()))<2,LEN(INDEX($D:$D,ROW()))<2,INDEX($M:$M,ROW())=\"\"),\"\",IF(LEFT(INDEX($C:$C,ROW()),2)=LEFT(INDEX($D:$D,ROW()),2),0,ROUND(INDEX($M:$M,ROW())*INDEX($K:$K,ROW())/100,2)))",
            "CGST": "==IF(OR(LEN(INDEX($C:$C,ROW()))<2,LEN(INDEX($D:$D,ROW()))<2,INDEX($M:$M,ROW())=\"\"),\"\",IF(LEFT(INDEX($C:$C,ROW()),2)=LEFT(INDEX($D:$D,ROW()),2),ROUND(INDEX($M:$M,ROW())*INDEX($K:$K,ROW())/200,2),0))",
            "SGST": "==IF(OR(LEN(INDEX($C:$C,ROW()))<2,LEN(INDEX($D:$D,ROW()))<2,INDEX($M:$M,ROW())=\"\"),\"\",IF(LEFT(INDEX($C:$C,ROW()),2)=LEFT(INDEX($D:$D,ROW()),2),ROUND(INDEX($M:$M,ROW())*INDEX($K:$K,ROW())/200,2),0))"
