        -880,
        380
      ],
      "parameters": {
        "jsCode": "// ✅ AGENT/BRAND ID FALLBACK — works for Webhook or Manual trigger\nlet agentId, brandId;\ntry {\n  agentId = $('Webhook').first().json.body.agentId;\n  brandId = $('Webhook').first().json.body.brandId;\n  if (!agentId || !brandId) throw new Error('empty');\n} catch (e) {\n  // Webhook didn't fire (Manual Trigger instead) → Koparo / PO Extractor fixed IDs\n  agentId = \"0a9f6d2e-5c31-4b88-9e77-1f4a2c6b8d05\";\n  brandId = \"546976a5-6ca5-42d1-8b7d-2c6379ffa221\";\n}\n\nconst allFiles = $('Search files and folders').all();\n\n// Already-claimed Drive file ids (Processed_Files tracker tab — safe on an empty sheet)\nconst processedIds = new Set();\ntry {\n  const raw = $('Get row(s) in sheet').first().json;\n  for (const row of (raw.values || [])) { if (row && row[0]) processedIds.add(String(row[0])); }\n} catch (e) { /* tab empty or unreadable — treat as no history */ }\n\nconst newFiles = allFiles.filter((item) => !processedIds.has(item.json.id));\nif (newFiles.length === 0) return [];\n\nreturn newFiles.map((item) => ({\n  json: {\n    ...item.json,\n    file_id: item.json.id,\n    agentId,\n    brandId,\n    agentName: 'PO Extractor',\n    brandName: 'Koparo',\n  },\n}));"
      }
