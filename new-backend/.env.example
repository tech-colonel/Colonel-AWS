PORT=8001
NODE_ENV=development

# ── Reco engine paths — leave blank to use project-relative defaults ──────────
BANK_CLASSIFIER_PATH=
RECO_TEMP_DIR=
RECO_OUTPUT_DIR=
LEDGER_MASTER_DIR=
MAX_CONCURRENT_RECO=8

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=24h

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=colonel-master
DB_NAME_MASTER=colonel-master

# ── Python Reco Engine ─────────────────────────────────────────────────────────
PYTHON_RECO_URL=http://localhost:8765

# ── Invoice Webhooks (n8n) — one URL + one sheet URL per brand ────────────────
# Format: <BrandName>_invoice_url and <BrandName>_invoice_sheet
# Example:
# Plenaire_invoice_url=https://your-n8n-instance.app.n8n.cloud/webhook/xxx
# Plenaire_invoice_sheet=https://docs.google.com/spreadsheets/d/xxx

# Password used by seed-user.js when provisioning demo users (was hardcoded; now env-driven)
SEED_USER_PASSWORD=ChangeMe123!

# ── Unified single-DB mode (DEFAULT — the canonical architecture) ─────────────
# All brands share ONE database (colonel_agent_accountant) with Postgres RLS
# isolation. This is ON BY DEFAULT — a fresh clone needs no flag. Restore the
# single dump in db-seed/ and go. Only set USE_UNIFIED_DB=false to fall back to
# the legacy one-DB-per-brand path (not recommended).
# USE_UNIFIED_DB=false             # escape hatch only — leave unset for unified
UNIFIED_DB_NAME=colonel_agent_accountant
DB_APP_USER=colonel_app            # non-superuser role (RLS enforces only for non-superusers)
DB_APP_PASSWORD=colonel_app_local  # must match the role created by db-seed/restore.sh
