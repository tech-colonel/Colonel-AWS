# ── Backend URL ────────────────────────────────────────────────────────────────
# For local development (default — no need to set this):
# REACT_APP_BACKEND_URL=http://localhost:8001

# For production / ngrok tunnel — uncomment and set your URL:
# REACT_APP_BACKEND_URL=https://your-ngrok-or-production-url.com

# ── Agent visibility ────────────────────────────────────────────────────────────
# Default (unset / false): show ALL agents — main branch + the 5 RECO agents.
# Set to true ONLY for the accountant-facing build (e.g. ngrok) to hide
# non-RECO agents and show just the 5 RECO agents.
# REACT_APP_RECO_ONLY=true
